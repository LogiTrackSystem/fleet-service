DATABASE_URL=postgresql://usuario:password@localhost:5432/fleet_db
# Clave compartida con el gateway y los demás servicios (producción). Vacía = sin restricción (local).
INTERNAL_API_KEY=

# Asignación por cercanía (reposicionamiento del vehículo hasta el origen del envío)
# Tope de kilómetros en línea recta entre la última ubicación real del vehículo y el origen. 0 = sin tope.
MAX_REPOSICION_KM=1500
# false = un vehículo vacío no cruza fronteras para ir a recoger (solo se consideran los de su mismo país)
REPOSICION_INTERNACIONAL=false

# Espera máxima (ms) por un candado de fila antes de fallar; 0 = sin límite
DB_LOCK_TIMEOUT_MS=15000
